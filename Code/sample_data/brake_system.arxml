<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Interfaces</SHORT-NAME>
      <ELEMENTS>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>IfWheelSpeed</SHORT-NAME>
          <DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>WheelSpeed</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Types/uint16</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>IfBrakeTorque</SHORT-NAME>
          <DATA-ELEMENTS><VARIABLE-DATA-PROTOTYPE><SHORT-NAME>BrakeTorqueRequest</SHORT-NAME><TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Types/float32</TYPE-TREF></VARIABLE-DATA-PROTOTYPE></DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <CLIENT-SERVER-INTERFACE>
          <SHORT-NAME>IfDiag</SHORT-NAME>
          <OPERATIONS><CLIENT-SERVER-OPERATION><SHORT-NAME>ReportEvent</SHORT-NAME></CLIENT-SERVER-OPERATION></OPERATIONS>
        </CLIENT-SERVER-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>WheelSpeedProvider</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE><SHORT-NAME>WheelSpeedOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IfWheelSpeed</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS><SWC-INTERNAL-BEHAVIOR><SHORT-NAME>Beh</SHORT-NAME>
            <EVENTS><TIMING-EVENT><SHORT-NAME>T5</SHORT-NAME><START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/WheelSpeedProvider/Beh/Run_WheelSpeed_5ms</START-ON-EVENT-REF><PERIOD>0.005</PERIOD></TIMING-EVENT></EVENTS>
            <RUNNABLES><RUNNABLE-ENTITY><SHORT-NAME>Run_WheelSpeed_5ms</SHORT-NAME></RUNNABLE-ENTITY></RUNNABLES>
          </SWC-INTERNAL-BEHAVIOR></INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>BrakeController</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE><SHORT-NAME>WheelSpeedIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IfWheelSpeed</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE><SHORT-NAME>BrakeTorqueOut</SHORT-NAME><PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IfBrakeTorque</PROVIDED-INTERFACE-TREF></P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE><SHORT-NAME>DiagOut</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/IfDiag</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS><SWC-INTERNAL-BEHAVIOR><SHORT-NAME>Beh</SHORT-NAME>
            <EVENTS><TIMING-EVENT><SHORT-NAME>T10</SHORT-NAME><START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/BrakeController/Beh/Run_BrakeCtrl_10ms</START-ON-EVENT-REF><PERIOD>0.01</PERIOD></TIMING-EVENT></EVENTS>
            <RUNNABLES><RUNNABLE-ENTITY><SHORT-NAME>Run_BrakeCtrl_10ms</SHORT-NAME></RUNNABLE-ENTITY></RUNNABLES>
          </SWC-INTERNAL-BEHAVIOR></INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE>
          <SHORT-NAME>ActuatorDriver</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE><SHORT-NAME>TorqueIn</SHORT-NAME><REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IfBrakeTorque</REQUIRED-INTERFACE-TREF></R-PORT-PROTOTYPE>
          </PORTS>
        </COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>BrakeSystem</SHORT-NAME>
          <COMPONENTS>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>wsp</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Components/WheelSpeedProvider</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>bc</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Components/BrakeController</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>act</SHORT-NAME><TYPE-TREF DEST="COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE">/Components/ActuatorDriver</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
          </COMPONENTS>
          <CONNECTORS>
            <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>c1</SHORT-NAME>
              <PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Components/BrakeSystem/wsp</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/WheelSpeedProvider/WheelSpeedOut</TARGET-P-PORT-REF></PROVIDER-IREF>
              <REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Components/BrakeSystem/bc</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/BrakeController/WheelSpeedIn</TARGET-R-PORT-REF></REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
            <ASSEMBLY-SW-CONNECTOR><SHORT-NAME>c2</SHORT-NAME>
              <PROVIDER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Components/BrakeSystem/bc</CONTEXT-COMPONENT-REF><TARGET-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/BrakeController/BrakeTorqueOut</TARGET-P-PORT-REF></PROVIDER-IREF>
              <REQUESTER-IREF><CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Components/BrakeSystem/act</CONTEXT-COMPONENT-REF><TARGET-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/ActuatorDriver/TorqueIn</TARGET-R-PORT-REF></REQUESTER-IREF>
            </ASSEMBLY-SW-CONNECTOR>
          </CONNECTORS>
        </COMPOSITION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
